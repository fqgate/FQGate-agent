{
  "name": "fqgate-plugin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "FQGate 跨 AI 工具插件界面项目。",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "build:universal": "npm run typecheck && node scripts/build-mcp-apps.mjs",
    "build:mcp-ui": "npm run build:universal",
    "build:mcp-apps": "npm run build:universal",
    "publish:dev": "npm run build:universal && node scripts/dev-publish-mcp-apps.mjs",
    "dev:publish": "npm run typecheck && node --watch-preserve-output --watch-path=src --watch-path=mcp-apps scripts/dev-publish-mcp-apps.mjs",
    "release:mcp-apps": "node scripts/release-mcp-apps.mjs",
    "test:mcp-apps": "tsx tests/openai-component-bridge.qa.ts && tsx tests/mcp-fqgate-fetch.qa.ts && tsx tests/mcp-polling-connection.qa.ts && npm run build:mcp-apps && node tests/mcp-apps-build.qa.mjs && node tests/mcp-apps-release.qa.mjs",
    "test:ui": "npm run test:ui:login && npm run test:ui:candle && npm run test:ui:information && npm run test:ui:market-quotes && npm run test:ui:order-flow",
    "test:ui:candle": "tsx tests/default-candle-interval.qa.ts && tsx tests/security-code.qa.ts && node tests/candle-preview.qa.mjs && node tests/candle-realtime.qa.mjs",
    "test:security-code": "tsx tests/security-code.qa.ts",
    "test:candle-default": "tsx tests/default-candle-interval.qa.ts",
    "test:ui:candle-realtime": "node tests/candle-realtime.qa.mjs",
    "test:ui:login": "node tests/login-preview.qa.mjs",
    "test:ui:information": "node tests/information-preview.qa.mjs",
    "test:ui:market-quotes": "node tests/market-quotes-preview.qa.mjs",
    "test:ui:order-flow": "node tests/order-flow-preview.qa.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@arco-design/web-vue": "2.58.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "lightweight-charts": "^5.2.1",
    "vue": "3.5.42",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "playwright": "1.63.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
